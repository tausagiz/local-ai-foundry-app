<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalAIChat.UI.ViewModels"
        x:Class="LocalAIChat.UI.Views.ProfileEditWindow"
        x:DataType="vm:ProfileEditViewModel"
        Width="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Edytuj profil">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="14"
          Margin="24">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Edytuj profil"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding ProfileName}"
                       Opacity="0.65" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Model" />
            <TextBox Text="{Binding ModelAlias, Mode=TwoWay}"
                     PlaceholderText="np. phi-4" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="System prompt" />
            <TextBox Text="{Binding SystemPrompt, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     MinHeight="150"
                     PlaceholderText="Instrukcje dla modelu" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="Anuluj"
                    Click="Cancel_Click"
                    IsCancel="True" />
            <Button Content="Zapisz"
                    Click="Save_Click"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>