<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LocalAIChat.UI.ViewModels"
        xmlns:views="using:LocalAIChat.UI.Views"
        x:Class="LocalAIChat.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="800"
        Height="600"
        Title="Local AI Chat">

    <Grid ColumnDefinitions="240,*,220">
        <Border Grid.Column="0"
                Background="#F3F4F6"
                BorderBrush="#D9DDE5"
                BorderThickness="0,0,1,0"
                Padding="12">
            <views:SessionListView DataContext="{Binding SessionList}" />
        </Border>

        <Grid Grid.Column="1"
              RowDefinitions="*,Auto"
              Margin="20">
            <ScrollViewer Grid.Row="0">
                <TextBlock Text="{Binding ChatOutput}"
                           TextWrapping="Wrap" />
            </ScrollViewer>

                <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <TextBox Grid.Column="0"
                     Text="{Binding UserInput, Mode=TwoWay}" />
                <Button Grid.Column="1"
                    Content="Wyślij"
                    Command="{Binding SendCommand}" />
                </Grid>
        </Grid>

        <Border Grid.Column="2"
                Background="#F8F9FB"
                BorderBrush="#D9DDE5"
                BorderThickness="1,0,0,0"
                Padding="16">
            <StackPanel Spacing="16">
                <TextBlock Text="Statystyki"
                           FontSize="18"
                           FontWeight="SemiBold" />

                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Model" Opacity="0.65" />
                        <TextBlock Text="{Binding CurrentModel}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Tryb" Opacity="0.65" />
                        <TextBlock Text="{Binding CurrentMode}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Input tokens" Opacity="0.65" />
                        <TextBlock Text="{Binding InputTokens}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Output tokens" Opacity="0.65" />
                        <TextBlock Text="{Binding OutputTokens}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Czas generowania" Opacity="0.65" />
                        <TextBlock Text="{Binding GenerationDurationMs, StringFormat='{}{0} ms'}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Kontekst" Opacity="0.65" />
                        <TextBlock Text="{Binding ContextMessageCount, StringFormat='{}{0} wiadomości'}" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

</Window>
